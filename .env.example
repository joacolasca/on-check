# Copiá a .env y completá. NUNCA commitear .env ni imprimir estos valores.
BASE_SEPOLIA_RPC_URL=
BASE_MAINNET_RPC_URL=
# En producción alcanzan 4 claves privadas: ORIGINADOR, ORACULO, INVERSOR1 e INVERSOR2.
# DEPLOYER (admin) y PYME pueden ir solo con su dirección pública (ADMIN_ADDRESS / PYME_ADDRESS); si ponés ambas, tienen que coincidir.
# Sin DEPLOYER_PRIVATE_KEY el KYC (POST /api/demo/kyc) queda deshabilitado (503).
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=
ORIGINADOR_PRIVATE_KEY=
ORACULO_PRIVATE_KEY=
INVERSOR1_PRIVATE_KEY=
INVERSOR2_PRIVATE_KEY=
PYME_PRIVATE_KEY=
PYME_ADDRESS=
CUIT_SALT=
CHEQUE_FUND_ADDRESS=
MOCK_ARGT_ADDRESS=
# Verificada en docs.twin.finance (Base mainnet, solo lectura): 0xf016413834E6D1A14F3D628B11D6Ef725a6bdbDD
ARGT_MAINNET_ADDRESS=
# Capa chain (Base Sepolia). Con CHEQUE_FUND_ADDRESS la API usa la blockchain real; sin ella, datos de prueba.
# BCRA_MODE=cache fuerza las copias guardadas del BCRA (para probar sin red); API_MODE=mock devuelve el ARGt de prueba.
# Sin contrato configurado la API responde 503 CONTRATO_NO_CONFIGURADO, salvo con API_MODE=mock.
# "mock" solo para desarrollar sin contrato; en la demo real dejalo vacío.
API_MODE=
# Agente analista de crédito (Claude). Sin ninguna clave corre en modo determinístico (gratis).
# OpenRouter (prioridad): modelo por defecto anthropic/claude-haiku-5.5. Guardala con: bash scripts/guardar-clave.sh openrouter
OPENROUTER_API_KEY=
# API directa de Anthropic (alternativa): modelo por defecto claude-sonnet-5-5.
ANTHROPIC_API_KEY=
# Opcional. OpenRouter: anthropic/claude-haiku-5.5 (por defecto) o anthropic/claude-sonnet-5.5. Directo: claude-sonnet-5-5.
AGENT_MODEL=
# Opcional. "determinista" fuerza el modo sin Claude aunque haya clave.
AGENT_MODE=
# Acceso a las rutas que firman con las wallets del servidor (kyc, invertir, liquidar, cheques, fondear). Mínimo 16 caracteres.
# Sin ella, en producción esas rutas devuelven 503. Los scripts la mandan en el header x-demo-clave; el equipo entra por /api/demo/acceso.
DEMO_CLAVE=
# Opcional. Tope en pesos (decimal) del tamaño del fondo tras un depósito de demo. Por defecto 32000000.
DEMO_TOPE_FONDO=
# Firma (HMAC) de las cotizaciones: sin firma válida, /api/cheques no acepta una cotización que vuelve del cliente. Mínimo 32 caracteres.
# Sin ella, en producción esas rutas devuelven 503; en desarrollo se usa un secreto aleatorio por proceso.
COTIZACION_SECRETO=
